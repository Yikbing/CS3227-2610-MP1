<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="760.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="studytracker.ui.MainWindow">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
    </padding>
    <Label styleClass="title" text="Study Tracker" />
    <Label styleClass="subtitle" text="Record completed study sessions and review your study history." />
    <TextArea fx:id="outputArea" editable="false" focusTraversable="false"
              VBox.vgrow="ALWAYS" wrapText="true" />
    <HBox spacing="10.0">
        <TextField fx:id="commandInput" HBox.hgrow="ALWAYS"
                   onAction="#handleCommand" promptText="Enter a command, or type help" />
        <Button fx:id="executeButton" defaultButton="true" mnemonicParsing="false"
                onAction="#handleCommand" text="Execute" />
    </HBox>
</VBox>
